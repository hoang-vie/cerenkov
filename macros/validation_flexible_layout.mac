/control/verbose 1
/run/verbose 1
/run/numberOfThreads 1

# Flexible readout-layout validation in one geometry build.
# Expected ChannelMap rows = 12 (1 + 4 + 3 + 0 + 2 + 2).
/detector/coreMaterial Water
/detector/coreSize 10 10 10 cm
/detector/readoutSize 5 5 1 mm
/detector/couplingSize 5 5 1 mm
/detector/tyvekHoleSize 5 5 1 mm
/detector/useAcrylicShell false
/detector/setTyvekThickness 0 mm

/readout/planeGrid +X true 1 1 10 10 0 0
/readout/planeGrid -X true 2 2 20 20 0 0
/readout/planeGrid +Z true 3 1 15 10 0 0
/readout/planeGrid -Z false 0 0 10 10 0 0
/readout/planeGrid +Y true 1 2 10 20 0 0
/readout/planeGrid -Y true 2 1 20 10 0 0
/detector/sensorMode DirectSiPM

/output/fileName validation_flexible_layout
/output/eventMode fullAll
/output/boundaryDebug false

/process/optical/processActivation Cerenkov false
/process/optical/processActivation Scintillation false
/process/optical/processActivation OpWLS false
/process/optical/processActivation OpWLS2 false
/run/initialize

/generator/mode Gun
/generator/particle mu-
/generator/energy 3 GeV
/generator/useAutoY true
/generator/direction 0 -1 0
/generator/time 0 ns
/run/beamOn 10
