# Detector-geometry mu+ lifetime validation at the stopping energy selected
# from validation_detector_muon_stopping_scan.mac.
#
# Baseline chosen from the user's coarse scan:
#   30 MeV -> 2000/2000 primary mu+ decayed in the Water Core.
#
# This stage measures:
#   1) truth proper lifetime from Track.EndProperTime_ns;
#   2) detector-like delayed timing using the Michel positron birth time relative
#      to the primary mu+ vertex time.
#
# Optical physics remains OFF intentionally. This keeps the test focused on
# charged-particle transport, stopping, decay timing, and ancestry.
#
# Geometry matches the current integrated detector baseline.

/control/verbose 1
/run/verbose 1
/run/numberOfThreads 1

# --- Current detector geometry baseline ---
/detector/coreMaterial Water
/detector/coreSize 10 10 10 cm
/detector/scintSize 110 10 110 mm
/detector/sipmSize 3 3 0.5 mm
/detector/couplingSize 3 3 1 mm
/detector/tyvekHoleSize 3 3 1 mm
/detector/useAcrylicShell true
/detector/setAcrylicThickness 3 mm
/detector/setTyvekThickness 0.1 mm
/detector/tyvekPosition Outside
/detector/scintGap 15 mm
/detector/sourceDistance 20 mm
/readout/uniformGrid 2 2 25 25
/detector/sensorMode DirectSiPM

# Production trigger is not used as the lifetime selector.
/trigger/scintThreshold 0.1 MeV
/trigger/integrationWindow 100 ns
/trigger/coincidenceWindow 100 ns

/output/fileName validation_detector_muon_lifetime
/output/eventMode fullAll
/output/incidentDetail minimal
/output/photonBirthDetail basic
/output/boundaryDebug false
/output/maxOpticalBounces 0
/output/compressionLevel 6

# Isolate charged-particle stopping + decay timing.
/process/optical/processActivation Cerenkov false
/process/optical/processActivation Scintillation false
/process/optical/processActivation OpAbsorption false
/process/optical/processActivation OpRayleigh false
/process/optical/processActivation OpMieHG false
/process/optical/processActivation OpBoundary false
/process/optical/processActivation OpWLS false
/process/optical/processActivation OpWLS2 false

/run/initialize

/generator/mode Gun
/generator/particle mu+
/generator/energy 30 MeV
/generator/position 0 0 0 mm
/generator/useAutoY true
/generator/direction 0 -1 0
/generator/time 0 ns

/run/printProgress 5000
/run/beamOn 100000
