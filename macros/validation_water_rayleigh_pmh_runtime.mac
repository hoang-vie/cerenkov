# Stage 3C/3E: Geant4 runtime validation of the production Zhang-Hu PMH
# Water_Default Rayleigh table. Stage 3E promoted the previously validated
# candidate to the default, so no expert override is required here.
#
# Four runs: 300, 400, 500, 600 nm.  The source starts at the centre of a
# 500-m water cube and travels +X.  No first Rayleigh scatter before the +X
# core boundary at 250 m is treated as right-censoring.
#
# OpAbsorption and OpBoundary are disabled to isolate OpRayleigh.

/control/verbose 1
/run/verbose 1
/run/numberOfThreads 1

/detector/coreMaterial Water
/detector/coreSize 500000 500000 500000 mm
/detector/useOuterShell false
/detector/setTyvekThickness 0 mm
/readout/uniformGrid 0 0 0 0

/output/fileName validation_water_rayleigh_pmh_runtime
/output/eventMode fullAll
/output/photonBirthDetail basic
/output/boundaryDebug false
/output/maxOpticalBounces 0

/process/optical/processActivation Cerenkov false
/process/optical/processActivation Scintillation false
/process/optical/processActivation OpAbsorption false
/process/optical/processActivation OpRayleigh true
/process/optical/processActivation OpMieHG false
/process/optical/processActivation OpBoundary false
/process/optical/processActivation OpWLS false
/process/optical/processActivation OpWLS2 false

/run/initialize
/generator/mode Gun
/generator/particle opticalphoton
/generator/useAutoY false
/generator/position 0 0 0 mm
/generator/direction 1 0 0
/generator/polarization 0 1 0
/generator/time 0 ns
/run/printProgress 5000

# run0: 300 nm
/generator/energy 4.13280661444 eV
/run/beamOn 20000

# run1: 400 nm
/generator/energy 3.09960496083 eV
/run/beamOn 20000

# run2: 500 nm
/generator/energy 2.479683968664 eV
/run/beamOn 20000

# run3: 600 nm
/generator/energy 2.06640330722 eV
/run/beamOn 20000
