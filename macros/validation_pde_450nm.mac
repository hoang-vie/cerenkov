/control/verbose 1
/run/verbose 1
/run/numberOfThreads 1

/detector/coreMaterial Water
/detector/coreSize 10 10 10 cm
/detector/readoutSize 10 10 1 mm
/detector/couplingSize 10 10 1 mm
/detector/tyvekHoleSize 10 10 1 mm
/detector/useAcrylicShell false
/detector/setTyvekThickness 0 mm
/readout/uniformGrid 0 0 10 10
/readout/planeGrid +Z true 1 1 10 10 0 0
/detector/sensorMode DirectSiPM
/output/fileName validation_pde_450nm
/output/eventMode fullAll
/output/incidentDetail phaseSpace
/output/photonBirthDetail basic
/output/boundaryDebug false
/output/maxOpticalBounces 0

/process/optical/processActivation Cerenkov false
/process/optical/processActivation Scintillation false
/process/optical/processActivation OpAbsorption false
/process/optical/processActivation OpRayleigh false
/process/optical/processActivation OpMieHG false
/process/optical/processActivation OpBoundary true
/process/optical/processActivation OpWLS false
/process/optical/processActivation OpWLS2 false
/run/initialize

/generator/mode Gun
/generator/particle opticalphoton
/generator/energy 2.755204 eV
/generator/useAutoY false
/generator/position 0 0 50.5 mm
/generator/direction 0 0 1
/generator/polarization 1 0 0
/generator/time 0 ns

/run/printProgress 10000
/run/beamOn 100000
