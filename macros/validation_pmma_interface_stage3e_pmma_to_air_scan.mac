/generator/direction 0.748955720789002 0.662620048215738 0
/generator/polarization -0.662620048215738 0.748955720789002 0
/run/beamOn 100000

# run10: theta_i=41.7 deg, s
/generator/direction 0.746638182285391 0.665230354654361 0
/generator/polarization 0 0 1
