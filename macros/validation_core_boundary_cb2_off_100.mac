/control/verbose 1
/run/verbose 1
/run/numberOfThreads 4

# Integrated end-to-end validation sample for analyze_general.C.
# This is NOT a replacement for the deterministic unit-style validators; it
# checks that the validated pieces remain mutually consistent in a normal run.
/detector/coreMaterial Water
/detector/coreSize 10 10 10 cm
/detector/scintSize 110 10 110 mm
/detector/sipmSize 3 3 0.5 mm
/detector/couplingSize 3 3 1 mm
/detector/tyvekHoleSize 3 3 1 mm
/detector/useOuterShell true
/detector/outerShellProfile PMMA_SNO_A
/detector/couplingProfile PDMS_Generic
/detector/outerShellThickness 3 mm
/detector/setTyvekThickness 0.1 mm
/detector/tyvekPosition Outside
/detector/scintGap 15 mm
/detector/sourceDistance 20 mm

# 4 channels per face x 6 faces = 24 direct-SiPM channels.
/readout/uniformGrid 2 2 25 25
/detector/sensorMode DirectSiPM

/trigger/scintThreshold 0.1 MeV
/trigger/integrationWindow 100 ns
/trigger/coincidenceWindow 100 ns

/output/fileName validation_core_boundary_cb2_off_100
/output/eventMode fullAll
/output/incidentDetail auto
/output/photonBirthDetail basic
/output/boundaryDebug false
/output/maxOpticalBounces 0
/output/compressionLevel 6

/process/optical/processActivation Cerenkov true
/process/optical/processActivation Scintillation false
/process/optical/processActivation OpAbsorption true
/process/optical/processActivation OpRayleigh true
/process/optical/processActivation OpMieHG false
/process/optical/processActivation OpBoundary true
/process/optical/processActivation OpWLS false
/process/optical/processActivation OpWLS2 false

/output/coreBoundaryMode off
/output/coreBoundaryDetail basic

/run/initialize

/generator/mode Gun
/generator/particle mu-
/generator/energy 3 GeV
/generator/position 0 0 0 mm
/generator/useAutoY true
/generator/direction 0 -1 0
/generator/time 0 ns

/run/printProgress 50
/run/beamOn 100
